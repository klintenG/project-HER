# ============================================
# Project HER - AI Article-to-Video Agent
# Environment Configuration
# ============================================

# Google AI Studio API Key (Primary LLM & Speech)
# Get a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-google-ai-studio-key-here

# Groq API Key (Optional free fallback)
# Get free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# LLM Provider: "gemini" (Google AI Pro - Default) | "groq" (Free fallback)
LLM_PROVIDER=gemini

# ═════════════════════════════════════════════════════════════════════════════
# ── AI MODELS CONFIGURATION (Single Source of Truth) ──────────────────────────
# Configure all AI models used across the application here in this single file.
# To switch models, change the variables below — no code changes required!
# ═════════════════════════════════════════════════════════════════════════════

# ── 1. Large Language Models (LLM) & Vision QA ──
GEMINI_MODEL=gemini-3.1-flash-lite            # Options: gemini-3.1-flash-lite, gemini-2.5-flash, gemini-2.5-pro
GROQ_MODEL=llama-3.1-8b-instant               # Options: llama-3.1-8b-instant, llama-3.3-70b-versatile
EDITORIAL_VISION_MODEL=gemini-3.1-flash-lite  # Multimodal inspection & visual QA model

# ── 2. Image Generation ──
# The only supported image models are configured in the narration-aware block below.
# All image requests use Replicate; no provider/model switching fallback exists.
PROJECTHER_IMAGE_PROVIDER=replicate
PROJECTHER_IMAGE_ASPECT_RATIO=1:1
PROJECTHER_IMAGE_MAX_CONCURRENCY=3
PROJECTHER_IMAGE_TIMEOUT_SECONDS=120

# ── 4. Speech Synthesis & Text-to-Speech (TTS) Models ──
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
NEWS_REPLICATE_TTS_MODEL=jaaari/kokoro-82m    # Options: jaaari/kokoro-82m, resemble-ai/chatterbox-turbo
ELEVENLABS_MODEL=eleven_multilingual_v2

# ── 5. Audio Alignment & Cutout Segmentation Models ──
HER_ALIGNMENT_MODEL=small             # Whisper model: tiny, base, small, medium, large-v3
NEWS_CUTOUT_MODELS=isnet-general-use  # Background removal: isnet-general-use, u2net

# Voice Engine: "google_tts" | "elevenlabs" | "replicate" (Kokoro) | "edge_tts"
TTS_PROVIDER=google_tts
GOOGLE_TTS_API_KEY=your-google-ai-studio-key-here

# ElevenLabs TTS (Optional premium narration)
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# Pexels API Key (required for stock images)
# Get free key at: https://www.pexels.com/api/
PEXELS_API_KEY=your-pexels-api-key-here


# Replicate API Token (paid, best quality + unlimited)
# Get token at: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_...

# Video defaults
DEFAULT_VIDEO_FORMAT=vertical
DEFAULT_TONE=informative
DEFAULT_VOICE=en-US-AriaNeural
WATERMARK_TEXT=Klin10

# ============================================
# Additive News mode (see README_NEWS.md)
# Reuses the configured LLM, image provider and TTS credentials above.
# Serper Google Search: needed for public topic queries / independent URL research.
# https://serper.dev/playground
SERPER_API_KEY=
NEWS_MAX_PAGES=3
NEWS_HTTP_TIMEOUT=30
NEWS_DEFAULT_DURATION=55
# Real named subjects: original reference first; approved models only when needed.
# Named-subject image-call limit, including failed attempts; 0 permits references/cache only.
NEWS_MAX_REAL_IMAGE_CALLS=8

# Optional CPU cutouts: pip install -r requirements-news.txt
# Python 3.9–3.12; first opaque image downloads ~179 MB of ISNet weights.
NEWS_CUTOUT_BACKEND=rembg
EDITORIAL_MAX_SUPPORT_CALLS=24
# Optional multimodal QA model; defaults to GEMINI_MODEL.
# EDITORIAL_VISION_MODEL=gemini-3.1-flash-lite
NEWS_CUTOUT_MODELS=isnet-general-use
NEWS_CUTOUT_CACHE=temp/news_cutouts
U2NET_HOME=temp/news-models
NUMBA_CACHE_DIR=temp/numba


# Music is quiet, ducked and optional. Verified assets registry is optional.
NEWS_MUSIC=0
NEWS_REPLICATE_ONLY=1
# Minimum seconds between uncached speech prediction requests in this process.
NEWS_REPLICATE_MIN_INTERVAL=12
# Retry only rejected HTTP 429 requests; total cooldown budget per narration.
NEWS_REPLICATE_RATE_LIMIT_RETRIES=7
NEWS_REPLICATE_RATE_LIMIT_WAIT=600
NEWS_VERIFIED_ASSETS_JSON=

# Optional reference_editorial forced alignment (local CPU, no paid API).
# Install requirements-editorial.txt and run scripts/setup_editorial.py first.
HER_ALIGNMENT_MODEL=small
# Keep runtime downloads disabled; missing models produce an actionable error.
HER_ALIGNMENT_DOWNLOAD=0

# Native klinteng.com studio. Cloud Run requires Firestore + a private bucket.
HER_PORTFOLIO_ENABLED=0
HER_PORTFOLIO_LOCK_LEGACY=0
HER_PORTFOLIO_SIGNING_KEY=
HER_OPERATOR_KEY=
HER_PORTFOLIO_BUCKET=
GOOGLE_CLOUD_PROJECT=
HER_PORTFOLIO_ORIGINS=https://klinteng.com,https://www.klinteng.com
HER_PORTFOLIO_DAILY_LIMIT=10
HER_PORTFOLIO_VISITOR_LIMIT=2
HER_PORTFOLIO_CONCURRENCY=1
# Leave 0 unless the number of trusted forwarding proxies has been verified.
HER_TRUSTED_PROXY_HOPS=0

# Narrative planning (reference_editorial only). Set the first three to 0 for rollback.
HER_NARRATIVE_VISUAL_PLANNER_V2=1
HER_ACTION_ASSETS_V2=1
HER_PARALLEL_ASSET_PIPELINE_V2=1
HER_EDITORIAL_ACTION_WORKERS=2
# Prediction admission is shared with Replicate speech; the larger minimum applies.
HER_EDITORIAL_IMAGE_MIN_INTERVAL=1
HER_EDITORIAL_IMAGE_TIMEOUT=180
# Canary: different color conversion, requires comparative export review.
HER_EDITORIAL_DIRECT_BT709=0
# Experimental matte recovery stays disabled in production.
HER_CUTOUT_MATTE_REPAIR=0

# Phase 2 editorial shot direction (only reference-v2 event/cutout scenes).
# OFF keeps Phase 1 assets/prompts and the previous reference renderer route.
HER_EDITORIAL_MOTION_V2_ENABLED=true
HER_EDITORIAL_MOTION_V2_INTENSITY=standard
HER_EDITORIAL_MOTION_V2_LAYOUT_VARIETY=true
HER_EDITORIAL_MOTION_V2_LAYERED_PARALLAX=true
HER_EDITORIAL_MOTION_V2_KINETIC_TEXT=true
HER_EDITORIAL_MOTION_V2_ALLOW_DOCUMENTARY_FRAMES=true
HER_EDITORIAL_MOTION_V2_MAX_IDENTICAL_LAYOUT_STREAK=2
HER_EDITORIAL_MOTION_V2_LONG_HOLD_WARNING_MS=4500
HER_EDITORIAL_MOTION_V2_ENTRY_MS=280
HER_EDITORIAL_MOTION_V2_EXIT_MS=160
HER_EDITORIAL_MOTION_V2_STAGGER_MS=130
# HER_EDITORIAL_EVENT_MODEL is the Gemini TEXT planner model (defaults to GEMINI_MODEL).

# --- Cost control (per video) ---
# Characters: PROJECTHER_IMAGE_IDENTITY_MODEL (above). Character actions/events: model below (falls back to CONTINUITY).
# Fallback hierarchy for critical (P0) scene events (prevents pipeline failure when retries exhaust)
PROJECTHER_ALLOW_CRITICAL_EVENT_FALLBACK=false
PROJECTHER_EVENT_MAX_ATTEMPTS=2
# Hard cap on paid scene predictions = events*(1+EXTRA)+SPARE (14 events -> 30 max, typical ~14-16)
PROJECTHER_IMAGE_EXTRA_ATTEMPTS_PER_EVENT=1
PROJECTHER_IMAGE_SPARE_CALLS=2

# Narration-aware image planning (takes precedence over legacy editorial image roles).
CHARACTER_IMAGE_MODEL=black-forest-labs/flux-schnell
OBJECT_IMAGE_MODEL=black-forest-labs/flux-schnell
BACKGROUND_IMAGE_MODEL=black-forest-labs/flux-schnell
SIMPLE_IMAGE_MODEL=black-forest-labs/flux-schnell
ACTION_IMAGE_MODEL=bytedance/seedream-4
SCHNELL_MAX_RETRIES=2
SEEDREAM_MAX_RETRIES=0
SEEDREAM_MAX_IMAGES=1
SEEDREAM_SEQUENTIAL_GENERATION=disabled
IMAGE_ASSET_PLANNER_ENABLED=true
TARGET_SCHNELL_RATIO=0.50
GENERATED_IMAGE_SOFT_TARGET=10
GENERATED_IMAGE_MAX=24
MAX_SEEDREAM_ACTION_IMAGES=16
ENABLE_ASSET_REUSE=true
ENABLE_CHARACTER_CONSISTENCY=true
ENABLE_CONTEXT_AWARE_PROMPTS=true
ENABLE_NEGATIVE_CONSTRAINTS=true
ENABLE_TEXT_ONLY_SCENES=true
ENABLE_REMOTION_3D_TEXT=true
SCHNELL_ESTIMATED_COST_USD=0.003
SEEDREAM_ESTIMATED_COST_USD=0.030
MAX_IMAGE_BUDGET_USD=0.60
MAX_TOTAL_VIDEO_BUDGET_USD=0.80
OTHER_SERVICES_RESERVED_USD=0.08
PROJECTHER_ALLOW_ASSET_OVERRUN=false
ENABLE_PREMIUM_FALLBACK=false
ENABLE_AUTOMATIC_MODEL_SWITCHING=false
# Only for preliminary timing; final plans are rebound to measured word timestamps.
PLANNER_WORDS_PER_MINUTE=150
# Typography pacing: select suitable conceptual beats globally, never a text-only run.
TYPOGRAPHY_BEAT_TARGET=4
TYPOGRAPHY_MIN_IMAGE_BEATS_BETWEEN=1

# Event quality controls (new names override the corresponding existing role names).
# IMAGE_CHARACTER_MODEL=black-forest-labs/flux-schnell
# IMAGE_PROP_MODEL=black-forest-labs/flux-schnell
# IMAGE_ACTION_MODEL=bytedance/seedream-4
IMAGE_ACTION_MAX_ATTEMPTS=1
IMAGE_ACTION_SIZE=2K
IMAGE_ENHANCE_PROMPT=true
# IMAGE_ESTIMATED_BUDGET_USD=0.60
ENABLE_EXPENSIVE_IMAGE_MODELS=false
IMAGE_VISION_QA_MODEL=
RENDER_BLOCK_ON_CRITICAL_VISUAL_FAILURE=false
VISUAL_QA_CONTACT_SHEET_FPS=1
# The defaults above accommodate the full 12-action Sisyphus fixture.
# Larger stories may require explicit count and budget adjustments.
# Budget conflicts block before image calls; never remove essential event imagery.
IMAGE_FAILURE_POLICY=deliver_with_warnings

# Identical requests can reuse saved media/results within this interval.
IMAGE_SAVED_JOB_REUSE_SECONDS=86400
# IMAGE_FAILURE_POLICY=strict opts back into rejection instead of delivery.
